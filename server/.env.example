# Copy to .env for local runs. On Render these are set in the dashboard instead — never commit
# a filled-in .env, and never put a token in render.yaml.

# Data source: "mock" (synthetic, no token) or "tradier"
PROVIDER=mock

# https://developer.tradier.com — the sandbox token is free and gives full chains with greeks
TRADIER_TOKEN=
# "sandbox" (delayed) or "live"
TRADIER_MODE=sandbox

PORT=4000

# Chains are cached this long so repeated scans do not burn the rate limit
CACHE_TTL_MS=300000

# Used in the probability model
RISK_FREE_RATE=0.04

# --- only relevant when this is reachable from the internet ---

# "production" makes the server serve the built UI itself and stop accepting cross-origin calls
NODE_ENV=

# HTTP basic auth. Leave APP_PASSWORD empty and the app is open to anyone with the URL: fine on
# localhost, not fine on a public host, where strangers would be spending your Tradier quota.
APP_USER=admin
APP_PASSWORD=

# Where the watchlist lives. On a host with an ephemeral disk, point this at a mounted volume
# or the watchlist resets to its defaults on every deploy.
DATA_FILE=
