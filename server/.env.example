# Copy to .env for local runs. On Render these are set in the dashboard instead — never commit
# a filled-in .env, and never put a token in render.yaml.

# Data source: "mock" (synthetic, no token) or "tradier"
PROVIDER=mock

# https://developer.tradier.com — the sandbox token is free and gives full chains with greeks
TRADIER_TOKEN=
# "sandbox" (delayed) or "live"
TRADIER_MODE=sandbox

PORT=4000

# Chains are cached this long so repeated scans do not burn the rate limit
CACHE_TTL_MS=300000

# Used in the probability model
RISK_FREE_RATE=0.04

# --- accounts ---

# Set this and the app switches from "one shared password, settings in a file" to "accounts,
# each with their own watchlist". Any Postgres will do; Neon and Supabase have free plans that
# do not expire, unlike Render's, which is deleted 30 days after creation.
DATABASE_URL=

# TLS to the database. Blank decides from the host (on for anything but localhost).
PGSSL=

# The first administrator, created on boot if that address has no account yet. An existing
# account is left alone, so a redeploy never resets a password you have since changed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true for one deploy to force the password above back onto that account — the way back in
# after a forgotten password, since this app sends no reset email. Turn it off again afterwards.
ADMIN_RESET=

# How long a sign-in lasts.
SESSION_TTL_DAYS=30

# --- only relevant when this is reachable from the internet ---

# "production" makes the server serve the built UI itself and stop accepting cross-origin calls
NODE_ENV=

# HTTP basic auth, used ONLY when DATABASE_URL is empty. Leave APP_PASSWORD empty and the app is
# open to anyone with the URL: fine on localhost, not fine on a public host, where strangers
# would be spending your Tradier quota.
APP_USER=admin
APP_PASSWORD=

# Where the watchlist lives. On a host with an ephemeral disk, point this at a mounted volume
# or the watchlist resets to its defaults on every deploy.
DATA_FILE=
